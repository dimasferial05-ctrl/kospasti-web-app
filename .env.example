# Database Configuration (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/kospasti?schema=public"

# Admin Dashboard Credentials
ADMIN_EMAIL="adminkospasti@gmail.com"
ADMIN_PASSWORD="kospasti123"

# Security & Authentication Tokens (WAJIB diganti dengan string acak yang aman di produksi!)
ADMIN_TOKEN="kospasti_admin_secret_token_change_in_production"
JWT_SECRET="kospasti_jwt_secret_min_32_chars_random_change_in_production"
CRON_SECRET="kospasti_cron_secret_random_token_change_in_production"

# Supabase Storage Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
SUPABASE_STORAGE_BUCKET="kospasti-media"

# Email Notification Fallback (Resend API - opsional, simulasi otomatis jika kosong)
RESEND_API_KEY=""
EMAIL_FROM="KosPasti <no-reply@kospasti.com>"

# WhatsApp Gateway (Fonnte) & Customer Support Floating Button
FONNTE_TOKEN=""
NEXT_PUBLIC_CS_WHATSAPP_NUMBER="6281234567890"

# Upstash Redis Configuration (Distributed Rate Limiting for Production)
# Opsional: Jika kosong, sistem otomatis fallback ke in-memory rate limiter lokal
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Midtrans Iris Disbursement API (Pencairan Otomatis Dana Mitra ke Bank)
# Opsional: Jika IRIS_API_KEY kosong atau IRIS_SIMULATION=true, sistem otomatis menggunakan Smart Simulator
IRIS_API_KEY=""
IRIS_IS_PRODUCTION=false
IRIS_SIMULATION=true

# Payment Simulation Guard (Default: false)
# PERINGATAN KEAMANAN (Issue #432): Pada mode produksi (NODE_ENV=production), simulasi pembayaran internal
# (/api/bookings/[id]/pay) dinonaktifkan mutlak (HTTP 404) demi integritas escrow dan proteksi finansial platform.
ENABLE_PAYMENT_SIMULATION=false

