// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Owner {
  id              String      @id @default(uuid())
  name            String
  whatsapp_number String      @unique
  email           String?     @unique // Tambahan untuk login portal
  password        String?             // Tambahan untuk login portal (Hashed)
  avatar_url      String?             // Foto profil atau logo pengelola kos
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  properties      Property[]
  magic_links     MagicLink[]
  payout_method   PayoutMethod?
  payouts         Payout[]
  notifications   Notification[]
  chat_rooms      ChatRoom[]
}

model Property {
  id              String          @id @default(uuid())
  name            String
  price_per_month Int             @default(0)
  available_rooms Int             @default(0)
  gender_type     String
  facilities      String
  image_url       String?
  address         String?
  latitude        Float?
  longitude       Float?
  is_pet_friendly Boolean         @default(false)
  is_24_hours     Boolean         @default(false)
  is_featured     Boolean         @default(false)
  featured_until  DateTime?
  status          String          @default("PENDING_REVIEW")
  rejectionReason String?
  rules           String?
  rental_terms    String?
  youtube_url     String?
  description     String?
  average_rating  Float           @default(0.0)
  total_reviews   Int             @default(0)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  owner_id        String
  owner           Owner           @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  room_types      RoomType[]
  bookings        Booking[]
  media           PropertyMedia[]
  saved_by        SavedProperty[]
  reviews         Review[]
  visits          VisitSchedule[]
  chat_rooms      ChatRoom[]

  @@index([owner_id])
  @@index([status])
  @@index([average_rating])
  @@index([latitude, longitude])
}

model RoomType {
  id              String    @id @default(uuid())
  name            String
  price_per_month Int
  security_deposit Int      @default(0)
  available_rooms Int       @default(0)
  facilities      String?
  specifications  String?
  image_url       String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  property_id     String
  property        Property  @relation(fields: [property_id], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@index([property_id])
}

model PropertyMedia {
  id          String   @id @default(uuid())
  url         String
  type        String   @default("IMAGE") // "IMAGE" atau "VIDEO"
  created_at  DateTime @default(now())
  property_id String
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@index([property_id])
}

model MagicLink {
  id         String         @id @default(uuid())
  token      String         @unique
  type       String         @default("ROOM_UPDATE") // "ROOM_UPDATE" | "BOOKING_VERIFICATION" | "VISIT_VERIFICATION"
  expires_at DateTime
  is_used    Boolean        @default(false)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt
  owner_id   String
  owner      Owner          @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  booking_id String?
  booking    Booking?       @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  visit_id   String?
  visit      VisitSchedule? @relation(fields: [visit_id], references: [id], onDelete: Cascade)
}

model Booking {
  id               String      @id @default(uuid())
  student_name     String
  student_whatsapp String
  move_in_date     DateTime
  status           String      @default("PENDING")
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt
  property_id      String
  property         Property    @relation(fields: [property_id], references: [id], onDelete: Cascade)
  room_type_id     String?
  room_type        RoomType?   @relation(fields: [room_type_id], references: [id], onDelete: SetNull)
  user_id                String?
  user                   User?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  cancellation_reason    String?
  refund_bank_name       String?
  refund_account_number  String?
  refund_account_holder  String?
  refund_note            String?
  refunded_at            DateTime?
  amount                 Int         @default(0)
  service_fee            Int         @default(5000)
  security_deposit       Int         @default(0)
  deposit_status         String?     @default("HELD") // "NONE" | "HELD" | "REFUNDED" | "CLAIMED"
  deposit_refunded_at    DateTime?
  deposit_claimed_amount Int?        @default(0)
  deposit_claim_reason   String?
  payment_gateway_ref    String?
  payment_method         String?
  snap_token             String?
  paid_at                DateTime?
  checkin_confirmed_at   DateTime?
  checkout_confirmed_at  DateTime?
  reminder_sent_at         DateTime?
  review_prompted_at       DateTime?
  payment_reminder_sent_at DateTime?
  magic_links            MagicLink[]
  review                 Review?
  payout                 Payout?
  chat_rooms             ChatRoom[]

  @@index([property_id])
  @@index([user_id])
  @@index([status])
  @@index([user_id, status])
  @@index([property_id, status])
}

model User {
  id               String          @id @default(uuid())
  name             String
  email            String          @unique
  password         String?
  whatsapp         String?
  avatar           String?
  bio              String?
  google_id        String?         @unique
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  bookings         Booking[]
  saved_properties SavedProperty[]
  reviews          Review[]
  notifications    Notification[]
  visits           VisitSchedule[]
  chat_rooms       ChatRoom[]
}

model SavedProperty {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  property_id String
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now())

  @@unique([user_id, property_id])
  @@index([user_id])
  @@index([property_id])
}

model Review {
  id          String   @id @default(uuid())
  rating      Int
  comment     String?
  images      String?
  reply       String?
  replied_at  DateTime?
  is_hidden   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  property_id String
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  booking_id  String   @unique
  booking     Booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@index([property_id])
  @@index([user_id])
}

model PayoutMethod {
  id             String    @id @default(uuid())
  owner_id       String    @unique
  owner          Owner     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  bank_name      String    // Contoh: "BCA", "BNI", "Mandiri", "GoPay", dll.
  account_number String    // Nomor rekening / nomor HP e-wallet
  account_holder String    // Nama pemilik rekening (HARUS sama persis dengan nama di bank)
  is_verified    Boolean   @default(false) // Admin yang set jadi true
  verified_at    DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
}

model Payout {
  id                     String    @id @default(uuid())
  booking_id             String    @unique
  booking                Booking   @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  owner_id               String
  owner                  Owner     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  amount                 Int       // Nominal yang dicairkan (dalam rupiah)
  gross_amount           Int       @default(0) // Total nilai transaksi sewa awal
  platform_fee           Int       @default(0) // Potongan komisi platform (misal 3%)
  net_amount             Int       @default(0) // Nominal bersih yang ditransfer ke pemilik
  status                 String    @default("PAYOUT_PENDING")
  // Status valid: "PAYOUT_PENDING" | "PAYOUT_PAID" | "PAYOUT_FAILED"
  payout_method_snapshot    String?   // JSON string: snapshot rekening saat payout diproses
  disbursement_id           String?   // ID transaksi payout dari Midtrans Iris
  disbursement_reference_no String?   // Nomor referensi bank dari disbursement gateway
  disbursement_status       String?   // "queued" | "completed" | "failed" | "simulated"
  disbursement_provider     String?   @default("MIDTRANS_IRIS")
  disbursement_error        String?   // Catatan error jika transfer ditolak gateway
  processed_at              DateTime? // Kapan admin memproses
  processed_by           String?   // Email/ID admin yang memproses
  notes                  String?   // Catatan internal admin
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  @@index([owner_id])
  @@index([status])
}

model Location {
  id          String   @id @default(uuid())
  name        String
  category    String   // "kampus" | "sekolah" | "rumah_sakit" | "pabrik" | "landmark" | "wilayah" | "kota"
  latitude    Float
  longitude   Float
  aliases     String?  // Daftar alias dipisahkan koma, contoh: "smeri, tubun, smk tubun"
  subdistrict String?  // Nama kecamatan di Subang, contoh: "Subang", "Cibogo", "Kalijati"
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@index([subdistrict])
}

model Notification {
  id         String    @id @default(uuid())
  user_id    String?
  user       User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  owner_id   String?
  owner      Owner?    @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  title      String
  message    String
  type       String    // "BOOKING_STATUS" | "PAYMENT_SUCCESS" | "CHECKIN_REMINDER" | "REVIEW_REPLY" | "PAYOUT_UPDATE" | "SYSTEM"
  link       String?
  is_read    Boolean   @default(false)
  read_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id, is_read])
  @@index([owner_id, is_read])
  @@index([created_at])
}

model VisitSchedule {
  id                   String      @id @default(uuid())
  property_id          String
  property             Property    @relation(fields: [property_id], references: [id], onDelete: Cascade)
  user_id              String?
  user                 User?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  student_name         String
  student_whatsapp     String
  visit_date           DateTime
  visit_time_slot      String
  notes                String?
  status               String      @default("PENDING") // "PENDING" | "ACCEPTED" | "REJECTED" | "RESCHEDULED" | "CANCELLED" | "COMPLETED"
  reschedule_date          DateTime?
  reschedule_time_slot     String?
  reschedule_note          String?
  student_reschedule_count Int         @default(0)
  cancellation_reason      String?
  created_at           DateTime    @default(now())
  updated_at           DateTime    @updatedAt
  magic_links          MagicLink[]

  @@index([property_id])
  @@index([user_id])
  @@index([status])
  @@index([visit_date])
}

model ChatRoom {
  id                   String        @id @default(uuid())
  property_id          String
  property             Property      @relation(fields: [property_id], references: [id], onDelete: Cascade)
  user_id              String
  user                 User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  owner_id             String
  owner                Owner         @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  booking_id           String?
  booking              Booking?      @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  last_message_at      DateTime      @default(now())
  last_message_preview String?
  user_unread_count    Int           @default(0)
  owner_unread_count   Int           @default(0)
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt
  messages             ChatMessage[]

  @@unique([user_id, owner_id, property_id])
  @@index([user_id])
  @@index([owner_id])
  @@index([property_id])
  @@index([last_message_at])
}

model ChatMessage {
  id          String    @id @default(uuid())
  room_id     String
  room        ChatRoom  @relation(fields: [room_id], references: [id], onDelete: Cascade)
  sender_type String    // "USER" | "OWNER" | "SYSTEM"
  sender_id   String    // user_id atau owner_id
  content     String    // Isi pesan teks
  is_read     Boolean   @default(false)
  read_at     DateTime?
  created_at  DateTime  @default(now())

  @@index([room_id, created_at])
}


